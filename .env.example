# Copy to .env for local development (run.bat does this for you).
# Never commit the real .env file.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://127.0.0.1:8000

# Leave unset locally to use SQLite. To develop against Postgres
# (docker compose up -d db), uncomment:
# DATABASE_URL=postgres://mpira:mpira@localhost:5432/mpira

# Where attachments are stored. On Railway: /data/media (inside the Volume).
# MEDIA_ROOT=

# Workspace limits.
MAX_ACTIVE_USERS=15
MAX_ATTACHMENT_SIZE_MB=10

# Password for the demo users created by `manage.py seed_demo`.
# Local dev only - these are test accounts (admin/maria/nikos/eleni @mpira.local).
DEMO_PASSWORD=mpira-demo-2026

# First admin, created idempotently on deploy by `manage.py ensure_admin`.
# MPIRA_ADMIN_EMAIL=
# MPIRA_ADMIN_PASSWORD=

# Email (mentions/notifications are in-app; email only for future use).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=
